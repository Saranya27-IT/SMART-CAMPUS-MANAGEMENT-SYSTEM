# ==============================================================
# SMART CAMPUS MANAGEMENT SYSTEM — Environment Variables Template
# ==============================================================
# Copy this file to .env.local and fill in your values.
# Get Supabase credentials from: https://supabase.com/dashboard
# → Your Project → Settings → API
# ==============================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase Service Role Key (server-only, NEVER commit real value)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App Name
NEXT_PUBLIC_APP_NAME=Smart Campus Management System
